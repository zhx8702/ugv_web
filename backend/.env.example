# Flask Configuration
FLASK_APP=app.main
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this

# Web UI login (leave AUTH_PASSWORD empty to disable)
AUTH_USER=ws
AUTH_PASSWORD=

# Server Configuration
HOST=0.0.0.0
PORT=5080

# Hardware Configuration
# UART_PORT: 留空自动检测树莓派版本 (Pi5=/dev/ttyAMA0, Pi4=/dev/serial0)
UART_PORT=
UART_BAUDRATE=115200

# Mock模式 - 在非树莓派环境测试时设为true
MOCK_MODE=false

# ROS2 / SLAM（未跑 rosbridge 时保持 false，避免启动报错）
ROS2_ENABLED=false

# 外设支持
USE_LIDAR=false
EXTRA_SENSOR=false

# Legacy
SERIAL_PORT=/dev/serial0
SERIAL_BAUDRATE=115200

# Video Configuration
CAMERA_INDEX=0
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_QUALITY=80

# Paths
MEDIA_PATH=/home/ws/media
PHOTOS_PATH=/home/ws/media/photos
VIDEOS_PATH=/home/ws/media/videos
SOUNDS_PATH=/home/ws/web-control/backend/sounds

# CORS
CORS_ORIGINS=http://localhost:3080,http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=/home/ws/web-control/backend/logs/app.log

# OTA Configuration
# Set to true if you want to build frontend locally on the device
# Default: false (frontend is pre-built by GitHub Actions)
BUILD_FRONTEND_LOCALLY=false

# AI Chat Configuration
AI_CHAT_API_URL=https://your-server.com
AI_CHAT_API_KEY=sk-ext-xxxxx
AI_CHAT_CHARACTER=UGV_Assistant
AI_CHAT_DEFAULT_SESSION=ugv-main
AI_CHAT_ENABLE_TTS=true
AI_CHAT_TTS_VOICE=zh-CN-XiaoxiaoNeural
